# WhisperWriter client in --remote mode: sends audio to the transcription
# server on gratitude. run.py auto-spawns the SSH tunnel.
#
# Install (laptop only):
#   cp systemd/whisper-writer-remote.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now whisper-writer-remote.service

[Unit]
Description=WhisperWriter client (remote transcription)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/utils/whisper-writer
ExecStart=%h/.local/bin/uv run python run.py --remote
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
